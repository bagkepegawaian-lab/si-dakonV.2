<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sertifikasi & Diklat - SI DAKON KEPEGAWAIAN</title>
    <base target="_top">
    <!-- Google Fonts Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- DataTables Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- jsPDF & AutoTable -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.25/jspdf.plugin.autotable.min.js"></script>
    <!-- SheetJS (XLSX) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
      :root {
        --tvk-blue: #004d40;
        --tvk-blue-dark: #00332b;
        --tvk-accent: #ffb74d;
        --tvk-bg: #f4f7f6;
        --font-main: 'Poppins', sans-serif;
      }

      body {
        background-color: var(--tvk-bg);
        font-family: var(--font-main);
        margin: 0;
        color: #1e293b;
        -webkit-font-smoothing: antialiased;
      }

      /* Indikator Loading Bar Atas */
      #loader-bar {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        background: var(--tvk-accent);
        z-index: 9999;
        width: 0%;
        transition: width 0.3s ease;
      }

      /* Top Navigation Bar */
      .top-nav {
        background: rgba(0, 0, 0, 0.28);
        backdrop-filter: blur(4px);
        padding: 10px 0;
        color: white;
        font-size: 0.84rem;
        position: absolute;
        width: 100%;
        z-index: 20;
      }

      .top-nav a {
        color: white;
        text-decoration: none;
        font-weight: 500;
        opacity: 0.92;
        transition: 0.25s;
      }

      .top-nav a:hover {
        opacity: 1;
        color: var(--tvk-accent);
      }

      /* Hero Header dengan Clip-Path Ellipse */
      .hero-container {
        background: linear-gradient(rgba(0, 77, 64, 0.89), rgba(0, 37, 31, 0.96)),
                    url('https://uinsa.ac.id/wp-content/uploads/2023/08/Twin-Towers-UINSA.jpg');
        background-size: cover;
        background-position: center;
        min-height: 270px;
        padding-top: 72px;
        padding-bottom: 88px;
        color: white;
        clip-path: ellipse(150% 100% at 50% 0%);
        position: relative;
      }

      .brand-logo {
        font-size: 1.75rem;
        font-weight: 800;
        color: white;
        text-decoration: none;
        letter-spacing: -0.5px;
      }

      .brand-logo span {
        font-weight: 300;
        color: var(--tvk-accent);
      }

      /* Filter Panel Melayang */
      .filter-panel {
        background: #ffffff;
        border-radius: 20px;
        padding: 24px 26px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.06);
        margin-top: -72px;
        position: relative;
        z-index: 10;
        border: 1px solid #e2e8f0;
      }

      .filter-panel .form-label {
        font-size: 0.72rem;
        letter-spacing: 0.5px;
        color: #64748b;
      }

      .filter-panel .form-control,
      .filter-panel .form-select {
        border-radius: 10px;
        border-color: #cbd5e1;
        font-size: 0.85rem;
        padding: 0.55rem 0.85rem;
      }

      .filter-panel .form-control:focus,
      .filter-panel .form-select:focus {
        border-color: var(--tvk-blue);
        box-shadow: 0 0 0 3px rgba(0, 77, 64, 0.1);
      }

      /* Banner Peringatan Masa Berlaku yang Elegan */
      .alert-expired-custom {
        background: linear-gradient(90deg, #fffbeb 0%, #fef2f2 100%);
        border: 1px solid #fed7aa;
        border-left: 4px solid #dc2626;
        border-radius: 12px;
        padding: 12px 16px;
        margin-top: 18px;
        margin-bottom: 0;
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.06);
      }

      /* Kartu Statistik */
      .stat-card {
        background: #ffffff;
        padding: 20px 22px;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        height: 100%;
        transition: all 0.25s ease;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--tvk-blue), #10b981);
      }

      .stat-card.stat-card-warn::before {
        background: linear-gradient(90deg, #f59e0b, #dc2626);
      }

      .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
      }

      .stat-card .stat-title {
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 6px;
        letter-spacing: 0.5px;
      }

      .stat-card h3 {
        font-weight: 800;
        font-size: 2rem;
        margin: 0;
        color: var(--tvk-blue);
        line-height: 1.15;
      }

      .stat-card .stat-sub {
        font-size: 0.74rem;
        color: #64748b;
        margin-top: 6px;
      }

      .stat-icon-circle {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
      }

      /* Container Tabel Utama */
      .card-white {
        background: #ffffff;
        padding: 24px 26px;
        border-radius: 18px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.03);
      }

      /* Banner Info Sandbox / Koneksi */
      .connection-notice {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1e40af;
        border-radius: 12px;
        padding: 10px 14px;
        font-size: 0.8rem;
        margin-bottom: 16px;
      }

      table.dataTable thead th {
        background: #f8fafc;
        color: var(--tvk-blue);
        white-space: nowrap !important;
        padding: 13px 12px !important;
        border-bottom: 2px solid #e2e8f0 !important;
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.4px;
        text-transform: uppercase;
      }

      table.dataTable tbody td {
        vertical-align: middle;
        padding: 13px 12px !important;
        font-size: 0.83rem;
        border-bottom: 1px solid #f1f5f9;
      }

      /* Highlight lembut untuk baris mendekati / melewati masa berlaku */
      tr.row-expired {
        background-color: #fff5f5 !important;
      }
      tr.row-expired:hover {
        background-color: #fee2e2 !important;
      }
      tr.row-warning {
        background-color: #fffdf0 !important;
      }
      tr.row-warning:hover {
        background-color: #fef3c7 !important;
      }

      .badge-jenis {
        background: #e6f4f1;
        color: #004d40;
        padding: 5px 11px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.72rem;
        display: inline-block;
        white-space: nowrap;
      }

      /* Badge Status Masa Berlaku */
      .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 50px;
        font-size: 0.71rem;
        font-weight: 600;
        line-height: 1.2;
        white-space: nowrap;
      }
      .status-pill-expired {
        background: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fca5a5;
      }
      .status-pill-warning {
        background: #fef3c7;
        color: #b45309;
        border: 1px solid #fcd34d;
      }
      .status-pill-active {
        background: #dcfce7;
        color: #15803d;
        border: 1px solid #86efac;
      }
      .status-pill-lifetime {
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #cbd5e1;
      }

      .btn-emerald {
        background: var(--tvk-blue);
        color: white;
        border: none;
        border-radius: 50px;
        padding: 9px 22px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: 0.25s;
      }

      .btn-emerald:hover {
        background: var(--tvk-blue-dark);
        color: white;
        transform: translateY(-1px);
      }

      .modal-form-header {
        background: linear-gradient(135deg, var(--tvk-blue), var(--tvk-blue-dark));
        color: white;
        padding: 1.2rem 1.6rem;
      }

      .modal-section-label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: var(--tvk-blue);
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 6px;
        margin-bottom: 12px;
      }

      /* Dropzone Import Excel */
      .import-dropzone {
        border: 2px dashed #94a3b8;
        border-radius: 16px;
        background: #f8fafc;
        padding: 28px 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.25s ease;
      }
      .import-dropzone:hover,
      .import-dropzone.dragover {
        border-color: #059669;
        background: #ecfdf5;
      }

      /* Action Group Berkas Sertifikat */
      .cert-action-group {
        display: inline-flex;
        align-items: center;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 50px;
        padding: 3px;
        gap: 3px;
      }

      .btn-cert-view {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border-radius: 50px;
        font-size: 11px;
        font-weight: 600;
        color: #004d40;
        background: transparent;
        text-decoration: none;
        transition: 0.2s;
      }

      .btn-cert-view:hover {
        background: #e0f2f1;
        color: #00332b;
      }

      .btn-cert-dl {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 11px;
        border-radius: 50px;
        font-size: 11px;
        font-weight: 600;
        color: #ffffff;
        background: linear-gradient(135deg, #059669, #004d40);
        text-decoration: none;
        box-shadow: 0 2px 5px rgba(5, 150, 105, 0.22);
        transition: 0.2s;
      }

      .btn-cert-dl:hover {
        color: #ffffff;
        filter: brightness(1.06);
        transform: translateY(-1px);
      }

      /* Kotak Status Folder Kolom Dokumen */
      .folder-status-box {
        border-radius: 10px;
        padding: 9px 13px;
        font-size: 0.79rem;
        margin-top: 8px;
        display: none;
      }

      .folder-status-ok {
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: #065f46;
        display: block;
      }

      .folder-status-smartchip {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1e40af;
        display: block;
      }

      .folder-status-warn {
        background: #fffbeb;
        border: 1px solid #fde68a;
        color: #92400e;
        display: block;
      }
    </style>
</head>
<body>

<!-- Loader Bar -->
<div id="loader-bar"></div>

<!-- Top Navigation -->
<div class="top-nav">
  <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>Aplikasi SI DAKON KEPEGAWAIAN</div>
    <div class="d-flex align-items-center flex-wrap gap-2">
      <a href="index.html"><i class="fas fa-arrow-left me-1"></i>Kembali ke Beranda</a>
      <button type="button" id="btnToggleAdmin" class="btn btn-sm btn-outline-warning rounded-pill px-3 py-0 ms-2" style="font-size: 0.75rem;" onclick="toggleAdminSession()">
        <i class="fas fa-user-lock me-1"></i>Admin Mode
      </button>
      <span id="adminBadge" class="ms-2 fw-bold text-warning" style="display:none;">
        <i class="fas fa-check-circle me-1"></i>ADMIN MODE
      </span>
    </div>
  </div>
</div>

<!-- Hero Header -->
<div class="hero-container">
  <div class="container">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div>
        <a href="index.html" class="brand-logo">Aplikasi<span> SI DAKON</span></a>
        <p class="mb-0 mt-1 text-white-50 small">Manajemen Sertifikasi, Pelatihan, Seminar &amp; Monitoring Masa Berlaku Kompetensi Pegawai</p>
      </div>
      <!-- Tombol Aksi Sejajar & Selalu Mudah Diakses -->
      <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-light rounded-pill px-3 fw-semibold btn-sm" onclick="bukaRekapAnalisis()">
          <i class="fas fa-chart-pie text-success me-1"></i> Rekap &amp; Analisis
        </button>
        <button class="btn btn-light rounded-pill px-3 fw-semibold btn-sm" onclick="cetakPDFSertifikasi()">
          <i class="fas fa-file-pdf text-danger me-1"></i> Cetak PDF
        </button>
        <button id="btnTemplateSertifikasi" class="btn btn-outline-light rounded-pill px-3 fw-semibold btn-sm" style="display:none;" onclick="downloadTemplateSertifikasiExcel()" title="Unduh file Excel template beserta panduan dan daftar pegawai">
          <i class="fas fa-file-excel me-1"></i> Template Excel
        </button>
        <button id="btnImportSertifikasi" class="btn btn-success rounded-pill px-3 fw-semibold btn-sm shadow-sm" style="display:none;" onclick="bukaModalImportExcel()" title="Import banyak data sertifikat sekaligus dari file Excel">
          <i class="fas fa-file-upload me-1"></i> Import Massal
        </button>
        <button id="btnInputSertifikasi" class="btn btn-warning rounded-pill px-4 fw-bold btn-sm text-dark" style="display:none;" onclick="bukaModalTambah()">
          <i class="fas fa-plus me-1"></i> Input Satuan
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Main Container -->
<div class="container pb-5">
  <!-- Filter Panel -->
  <div class="filter-panel mb-4">
    <div class="row g-3 align-items-end">
      <div class="col-lg-4 col-md-6">
        <label class="form-label fw-bold mb-1">PENCARIAN CEPAT</label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 10px 0 0 10px;"><i class="fas fa-search"></i></span>
          <input type="text" id="filterSearch" class="form-control border-start-0" style="border-radius: 0 10px 10px 0;" placeholder="Cari Nama, NIP, Judul, atau Nomor...">
        </div>
      </div>
      <div class="col-lg-3 col-md-6">
        <label class="form-label fw-bold mb-1">JENIS KEGIATAN</label>
        <select id="filterJenis" class="form-select">
          <option value="">Semua Jenis Kegiatan</option>
          <option value="Sertifikat Pendidik">Sertifikat Pendidik (Serdos)</option>
          <option value="Diklat Teknis">Diklat Teknis</option>
          <option value="Diklat Kepemimpinan">Diklat Kepemimpinan</option>
          <option value="Workshop / Bimtek">Workshop / Bimtek</option>
          <option value="Seminar / Konferensi">Seminar / Konferensi</option>
          <option value="Sertifikasi Kompetensi">Sertifikasi Kompetensi</option>
        </select>
      </div>
      <div class="col-lg-2 col-md-5">
        <label class="form-label fw-bold mb-1">STATUS BERLAKU</label>
        <select id="filterStatus" class="form-select">
          <option value="">Semua Status</option>
          <option value="perlu_perhatian">Perlu Perhatian</option>
          <option value="segera_habis">Segera Habis (&le;30 Hari)</option>
          <option value="expired">Sudah Kedaluwarsa</option>
          <option value="aktif">Masih Berlaku</option>
          <option value="seumur_hidup">Seumur Hidup</option>
        </select>
      </div>
      <div class="col-lg-1 col-md-4">
        <label class="form-label fw-bold mb-1">TAHUN</label>
        <select id="filterTahun" class="form-select">
          <option value="">Semua</option>
        </select>
      </div>
      <div class="col-lg-2 col-md-3">
        <button class="btn btn-outline-secondary w-100 fw-semibold" style="border-radius: 10px; padding: 0.55rem 0.85rem; font-size: 0.85rem;" onclick="resetFilter()">
          <i class="fas fa-sync-alt me-1"></i> Reset
        </button>
      </div>
    </div>

    <!-- Banner Alert Peringatan Masa Berlaku Otomatis -->
    <div id="alert-expired-banner" class="alert alert-expired-custom d-flex flex-wrap justify-content-between align-items-center gap-2" style="display:none !important;">
      <div class="d-flex align-items-center gap-2 small text-dark">
        <span class="badge bg-danger rounded-pill px-2 py-1"><i class="fas fa-bell me-1"></i>PERINGATAN MASA BERLAKU</span>
        <span id="alert-expired-text"></span>
      </div>
      <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-sm btn-warning fw-semibold rounded-pill px-3 text-dark" onclick="$('#filterStatus').val('segera_habis').trigger('change')">
          Lihat Segera Habis
        </button>
        <button type="button" class="btn btn-sm btn-danger fw-semibold rounded-pill px-3" onclick="$('#filterStatus').val('expired').trigger('change')">
          Lihat Kedaluwarsa
        </button>
      </div>
    </div>
  </div>

  <!-- Statistik Ringkas (4 Kartu Sejajar Rapi - Semua Dapat Diklik) -->
  <div class="row g-3 g-md-4 mb-4">
    <div class="col-lg-3 col-sm-6">
      <div class="stat-card" style="cursor:pointer;" onclick="bukaDetailStatistik('total_sertifikat')" title="Klik untuk melihat daftar semua sertifikat & nama pegawai">
        <div class="d-flex justify-content-between align-items-start gap-2">
          <div>
            <div class="stat-title">Total Sertifikat</div>
            <h3 id="stat-total-sertifikat">0</h3>
          </div>
          <div class="stat-icon-circle bg-success bg-opacity-10 text-success">
            <i class="fas fa-certificate"></i>
          </div>
        </div>
        <div class="stat-sub">Arsip diklat &amp; kompetensi</div>
      </div>
    </div>
    <div class="col-lg-3 col-sm-6">
      <div class="stat-card" style="cursor:pointer;" onclick="bukaDetailStatistik('pegawai_unik')" title="Klik untuk melihat daftar nama pegawai tersertifikasi">
        <div class="d-flex justify-content-between align-items-start gap-2">
          <div>
            <div class="stat-title">Pegawai Tersertifikasi</div>
            <h3 id="stat-total-pegawai" style="color: #00796b;">0</h3>
          </div>
          <div class="stat-icon-circle bg-primary bg-opacity-10 text-primary">
            <i class="fas fa-user-check"></i>
          </div>
        </div>
        <div class="stat-sub">Pegawai unik terdata</div>
      </div>
    </div>
    <div class="col-lg-3 col-sm-6">
      <div class="stat-card" style="cursor:pointer;" onclick="bukaDetailStatistik('akumulasi_jp')" title="Klik untuk melihat rincian akumulasi JP per pegawai">
        <div class="d-flex justify-content-between align-items-start gap-2">
          <div>
            <div class="stat-title">Akumulasi Jam Pelajaran</div>
            <h3 id="stat-total-jp" style="color: #f57c00;">0 JP</h3>
          </div>
          <div class="stat-icon-circle bg-warning bg-opacity-10 text-warning">
            <i class="fas fa-clock"></i>
          </div>
        </div>
        <div class="stat-sub">Total jam pengembangan kompetensi</div>
      </div>
    </div>
    <div class="col-lg-3 col-sm-6">
      <div class="stat-card stat-card-warn" style="cursor:pointer;" onclick="bukaDetailStatistik('perlu_perpanjang')" title="Klik untuk melihat nama pegawai yang sertifikatnya perlu diperpanjang">
        <div class="d-flex justify-content-between align-items-start gap-2">
          <div>
            <div class="stat-title">Perlu Perpanjangan</div>
            <h3 id="stat-perlu-perhatian" style="color: #dc2626;">0</h3>
          </div>
          <div class="stat-icon-circle bg-danger bg-opacity-10 text-danger">
            <i class="fas fa-exclamation-triangle"></i>
          </div>
        </div>
        <div class="stat-sub" id="stat-perlu-perhatian-sub">0 kedaluwarsa &bull; 0 segera habis</div>
      </div>
    </div>
  </div>

  <!-- Diagram Pie Perbandingan Jenis Diklat / Sertifikasi -->
  <div class="card-white mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-3 border-bottom gap-2">
      <div>
        <h5 class="fw-bold m-0" style="color: var(--tvk-blue);">Perbandingan Berdasarkan Jenis Diklat</h5>
        <small class="text-muted">Klik bagian diagram atau kategori di samping untuk melihat daftar nama pegawai</small>
      </div>
      <span id="badge-chart-jenis-total" class="badge rounded-pill px-3 py-2 fw-semibold" style="background: #e6f4f1; color: #004d40; font-size: 0.76rem;">
        Total: 0 Sertifikat
      </span>
    </div>
    <div class="row align-items-center g-4">
      <div class="col-lg-4 col-md-5">
        <div style="height: 220px; position: relative;">
          <canvas id="pieChartJenisDiklat"></canvas>
        </div>
      </div>
      <div class="col-lg-8 col-md-7">
        <div id="legendJenisDiklatContainer" class="row g-2">
          <div class="col-12 text-center text-muted py-4 small">Memuat diagram perbandingan...</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabel Riwayat Sertifikasi -->
  <div class="card-white">
