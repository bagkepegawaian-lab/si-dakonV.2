function prosesBacaFileExcelImport(inputOrFile) {
  const file = inputOrFile && inputOrFile.files ? inputOrFile.files[0] : inputOrFile;
  if (!file) return;

  const reader = new FileReader();
  reader.onload = function(e) {
    try {
      const data = new Uint8Array(e.target.result);
      const wb = XLSX.read(data, { type: 'array' });
      const sheetName = wb.SheetNames.includes('InputDataSertifikasi') ? 'InputDataSertifikasi' : wb.SheetNames[0];
      const ws = wb.Sheets[sheetName];
      const rows = XLSX.utils.sheet_to_json(ws, { defval: "" });

      if (!rows || rows.length === 0) {
        Swal.fire('File Kosong', 'Tidak ditemukan baris data pada sheet Excel yang dipilih.', 'warning');
        return;
      }

      const validList = [];
      let skippedCount = 0;

      rows.forEach(r => {
        const getCol = (...keys) => {
          for (const k of keys) {
            const foundKey = Object.keys(r).find(rk => rk.trim().toUpperCase() === k.toUpperCase());
            if (foundKey !== undefined && String(r[foundKey]).trim() !== '') {
              return String(r[foundKey]).trim();
            }
          }
          return '';
        };

        const rawNip = getCol('NIP', 'NIP PEGAWAI').replace(/^'/, '');
        const rawNama = getCol('NAMA', 'NAMA PEGAWAI', 'PEGAWAI');
        const judul = getCol('JUDUL', 'JUDUL KEGIATAN', 'JUDUL SERTIFIKASI', 'NAMA DIKLAT');

        if (!rawNama && !judul) {
          skippedCount++;
          return;
        }
        if (!judul) {
          skippedCount++;
          return;
        }

        const matched = cariPegawaiDiMaster(rawNip, rawNama);
        const rawTgl = r.TANGGAL !== undefined ? r.TANGGAL : getCol('TANGGAL', 'TANGGAL SK', 'TANGGAL TERBIT', 'TGL');
        const rawExp = r.TANGGAL_EXPIRED !== undefined ? r.TANGGAL_EXPIRED : getCol('TANGGAL_EXPIRED', 'EXPIRED', 'BERLAKU SAMPAI', 'MASA BERLAKU');
        const rawTahunBerlaku = parseInt(getCol('MASA_BERLAKU_TAHUN', 'MASA BERLAKU TAHUN', 'TAHUN BERLAKU', 'DURASI'), 10);

        const tglTerbitIso = formatTanggalInput(rawTgl);
        let tglExpiredIso = formatTanggalInput(rawExp);

        // Jika TANGGAL_EXPIRED kosong namun MASA_BERLAKU_TAHUN diisi, hitung otomatis dari tanggal SK
        if (!tglExpiredIso && tglTerbitIso && !isNaN(rawTahunBerlaku) && rawTahunBerlaku > 0) {
          const pts = tglTerbitIso.split('-').map(Number);
          const dCalc = new Date(pts[0] + rawTahunBerlaku, pts[1] - 1, pts[2]);
          if (dCalc.getMonth() !== pts[1] - 1) dCalc.setDate(0);
          tglExpiredIso = `${dCalc.getFullYear()}-${String(dCalc.getMonth() + 1).padStart(2, '0')}-${String(dCalc.getDate()).padStart(2, '0')}`;
        }

        validList.push({
          nip: rawNip || (matched ? matched.nip : ''),
          nama: rawNama || (matched ? matched.nama : ''),
          matchedMaster: !!matched,
          jenis: getCol('JENIS', 'JENIS KEGIATAN') || 'Diklat Teknis',
          nomor: getCol('NOMOR', 'NOMOR SERTIFIKAT') || '-',
          judul: judul,
          penyelenggara: getCol('PENYELENGGARA', 'INSTANSI') || '-',
          tanggal: tglTerbitIso,
          tanggalExpired: tglExpiredIso,
          jp: parseFloat(getCol('JP', 'JUMLAH JP')) || 0,
          link: getCol('LINK_SERTIFIKAT', 'LINK', 'URL'),
          folderUrl: matched ? matched.folderUrl : '',
          folderId: matched ? matched.folderId : ''
        });
      });

      if (validList.length === 0) {
        Swal.fire('Format Tidak Valid', 'Pastikan file Excel memiliki minimal kolom NAMA dan JUDUL yang terisi.', 'warning');
        return;
      }

      parsedImportItems = validList;
      $('#importSummaryBadge').text(`${validList.length} baris valid siap disimpan`);
      if (skippedCount > 0) {
        $('#importWarningBadge').text(`${skippedCount} baris kosong dilewati`).show();
      } else {
        $('#importWarningBadge').hide();
      }

      const previewHtml = validList.map((it, idx) => {
        const matchBadge = it.matchedMaster
          ? '<span class="badge bg-success bg-opacity-10 text-success border border-success"><i class="fas fa-check me-1"></i>Cocok</span>'
          : '<span class="badge bg-secondary bg-opacity-10 text-secondary border">Manual</span>';
        return `
          <tr>
            <td class="text-center text-muted">${idx + 1}</td>
            <td><div class="fw-bold">${it.nama || '-'}</div><div class="font-monospace text-muted" style="font-size:11px;">${it.nip || '-'}</div></td>
            <td class="text-center">${matchBadge}</td>
            <td>${it.jenis}</td>
            <td><div class="fw-semibold">${it.judul}</div><div class="text-muted" style="font-size:11px;">No: ${it.nomor}</div></td>
            <td>${it.penyelenggara}</td>
            <td class="text-nowrap">${it.tanggal ? formatTanggalIndo(it.tanggal) : '-'}</td>
            <td class="text-nowrap">${it.tanggalExpired ? formatTanggalIndo(it.tanggalExpired) : '<span class="text-muted">Seumur Hidup</span>'}</td>
            <td class="text-center fw-bold text-success">${it.jp}</td>
          </tr>
        `;
      }).join('');

      $('#importPreviewTbody').html(previewHtml);
      $('#importPreviewSection').show();
      $('#btnEksekusiImport').prop('disabled', false);
      $('#btnImportCount').text(validList.length);
    } catch (err) {
      console.error('Error parse Excel:', err);
      Swal.fire('Gagal Membaca Excel', 'Pastikan file berformat .xlsx atau .xls yang tidak rusak.', 'error');
    }
  };
  reader.readAsArrayBuffer(file);
}

async function eksekusiImportMassal() {
  if (!parsedImportItems || parsedImportItems.length === 0) return;

  if (!cekStatusAdmin()) {
    toggleAdminSession(() => eksekusiImportMassal());
    return;
  }

  const total = parsedImportItems.length;
  let berhasil = 0;
  let gagal = 0;

  Swal.fire({
    title: 'Mengimpor Data Sertifikasi...',
    html: `
      <div class="mb-2 small text-muted">Menyimpan <b id="imp-curr">0</b> dari <b>${total}</b> data ke spreadsheet...</div>
      <div class="progress" style="height: 12px; border-radius: 50px;">
        <div id="imp-progress-bar" class="progress-bar progress-bar-striped progress-bar-animated bg-success" style="width: 0%;"></div>
      </div>
    `,
    allowOutsideClick: false,
    didOpen: () => Swal.showLoading()
  });

  for (let i = 0; i < total; i++) {
    const item = parsedImportItems[i];
    try {
      const resp = await fetch(SCRIPT_URL_BOS, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({
          action: 'saveSertifikasi',
          nip: item.nip,
          nama: item.nama,
          jenis: item.jenis,
          nomor: item.nomor,
          judul: item.judul,
          penyelenggara: item.penyelenggara,
          tanggal: item.tanggal,
          tanggalExpired: item.tanggalExpired,
          jp: item.jp,
          existingLink: item.link,
          folderUrl: item.folderUrl,
          folderId: item.folderId
        })
      });
      let resJson = null;
      try { resJson = await resp.json(); } catch (e) {}
      if (resJson && (resJson.success === false || resJson.status === 'error')) {
        gagal++;
      } else {
        berhasil++;
      }
    } catch (e) {
      gagal++;
    }

    const pct = Math.round(((i + 1) / total) * 100);
    $('#imp-curr').text(i + 1);
    $('#imp-progress-bar').css('width', `${pct}%`);
  }

  $('#modalImportExcel').modal('hide');
  resetPreviewImportExcel();

  Swal.fire({
    icon: berhasil > 0 ? 'success' : 'error',
    title: 'Proses Import Selesai',
    html: `Berhasil menyimpan <b>${berhasil}</b> data sertifikasi.${gagal > 0 ? `<br><span class="text-danger small">${gagal} baris gagal terkirim.</span>` : ''}`,
    confirmButtonColor: '#004d40'
  });

  setTimeout(() => muatSemuaData(true), 800);
}

