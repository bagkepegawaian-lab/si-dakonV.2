/**
 * Memparsing respons data sertifikasi dengan aman
 */
function parseDataSertifikasiResponse(resSertifikasi) {
  let rawRows = [];
  if (Array.isArray(resSertifikasi)) {
    rawRows = resSertifikasi;
  } else if (resSertifikasi && Array.isArray(resSertifikasi.values)) {
    rawRows = resSertifikasi.values;
  } else if (resSertifikasi && Array.isArray(resSertifikasi.data)) {
    rawRows = resSertifikasi.data;
  }

  return rawRows.map((row, idx) => {
    if (Array.isArray(row)) {
      const rawExp = row.length > 10 ? row[10] : '';
      const tglExp = formatTanggalInput(rawExp);
      return {
        rowIndex: idx + 2,
        id: String(row[0] || `SRT-${idx + 1}`).trim(),
        nip: String(row[1] || '').replace(/^'/, '').trim(),
        nama: String(row[2] || '').trim(),
        jenis: String(row[3] || '-').trim(),
        nomor: String(row[4] || '-').trim(),
        judul: String(row[5] || '-').trim(),
        penyelenggara: String(row[6] || '-').trim(),
        tanggal: formatTanggalInput(row[7]),
        tanggalTampil: formatTanggalIndo(row[7]),
        jp: parseFloat(row[8]) || 0,
        link: String(row[9] || '').trim(),
        tanggalExpired: tglExp,
        tanggalExpiredTampil: tglExp ? formatTanggalIndo(tglExp) : ''
      };
    } else if (row && typeof row === 'object') {
      const rawExp = row.tanggalExpired || row.TANGGAL_EXPIRED || row.masaBerlaku || '';
      const tglExp = formatTanggalInput(rawExp);
      return {
        rowIndex: idx + 2,
        id: String(row.id || row.ID || `SRT-${idx + 1}`).trim(),
        nip: String(row.nip || row.NIP || '').replace(/^'/, '').trim(),
        nama: String(row.nama || row.NAMA || '').trim(),
        jenis: String(row.jenis || row.JENIS || '-').trim(),
        nomor: String(row.nomor || row.NOMOR || '-').trim(),
        judul: String(row.judul || row.JUDUL || '-').trim(),
        penyelenggara: String(row.penyelenggara || row.PENYELENGGARA || '-').trim(),
        tanggal: formatTanggalInput(row.tanggal || row.TANGGAL),
        tanggalTampil: formatTanggalIndo(row.tanggal || row.TANGGAL),
        jp: parseFloat(row.jp || row.JP) || 0,
        link: String(row.link || row.LINK || '').trim(),
        tanggalExpired: tglExp,
        tanggalExpiredTampil: tglExp ? formatTanggalIndo(tglExp) : ''
      };
    }
    return null;
  }).filter(item => item && (item.nama || item.judul !== '-'));
}

async function muatSemuaData(forceRefresh = false) {
  $('#loader-bar').css('width', '35%');

  if (!forceRefresh) {
    try {
      const cachedPegawai = localStorage.getItem(PEGAWAI_CACHE_KEY);
      if (cachedPegawai) {
        const parsedPegawai = JSON.parse(cachedPegawai);
        const cachedList = parseDataPegawaiSheet(parsedPegawai);
        if (cachedList.length > 0) {
          daftarPegawai = cachedList;
          isiDropdownPegawai();
        }
      }
      const cachedSertifikat = localStorage.getItem(SERTIFIKASI_CACHE_KEY);
      if (cachedSertifikat) {
        const parsedSertifikat = JSON.parse(cachedSertifikat);
        if (Array.isArray(parsedSertifikat) && parsedSertifikat.length > 0) {
          dataSertifikasi = parsedSertifikat;
          isiFilterTahun();
          perbaruiStatistik();
          renderTabelSertifikasi();
        }
      }
    } catch (e) {}
  }

  try {
    const [resPegawai, resSertifikasi] = await Promise.all([
      fetch(`${SCRIPT_URL_BOS}?t=${Date.now()}`).then(r => r.json()),
      fetch(`${SCRIPT_URL_BOS}?action=getSertifikasi&t=${Date.now()}`).then(r => r.json())
    ]);

    $('#loader-bar').css('width', '80%');
    isOfflineOrSandbox = false;
    $('#sandboxNoticeBox').addClass('d-none');
    $('#connectionStatusBadge').show();

    if (resPegawai && Array.isArray(resPegawai.headers) && Array.isArray(resPegawai.values)) {
      daftarPegawai = parseDataPegawaiSheet(resPegawai);
      isiDropdownPegawai();
      try {
        localStorage.setItem(PEGAWAI_CACHE_KEY, JSON.stringify({
          headers: resPegawai.headers,
          values: resPegawai.values
        }));
      } catch (e) {}
    }

    dataSertifikasi = parseDataSertifikasiResponse(resSertifikasi);
    try {
      localStorage.setItem(SERTIFIKASI_CACHE_KEY, JSON.stringify(dataSertifikasi));
    } catch (e) {}

    isiFilterTahun();
    perbaruiStatistik();
    renderTabelSertifikasi();
    cekPrefillUrlParams();

    $('#loader-bar').css('width', '100%');
    setTimeout(() => $('#loader-bar').css('width', '0%'), 400);
  } catch (err) {
    console.warn('Koneksi ke server GAS dibatasi atau terputus:', err);
    isOfflineOrSandbox = true;
    $('#loader-bar').css('width', '0%');
    $('#connectionStatusBadge').hide();
    $('#sandboxNoticeBox').removeClass('d-none');

    if (dataSertifikasi.length === 0) {
      $('#sandboxNoticeText').html(
        'Belum ada data yang ditampilkan karena koneksi ke server dibatasi di preview browser ini. ' +
        'Silakan buka halaman ini di alamat aplikasi resmi Anda agar data terhubung langsung.'
      );
    } else {
      $('#sandboxNoticeText').html(
        `Menampilkan <b>${dataSertifikasi.length} data</b> dari penyimpanan lokal terakhir karena sinkronisasi ke server sedang terputus.`
      );
    }

    isiFilterTahun();
    perbaruiStatistik();
    renderTabelSertifikasi();
  }
}

