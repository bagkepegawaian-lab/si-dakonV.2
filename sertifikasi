<script>
const SCRIPT_URL_BOS = "https://script.google.com/macros/s/AKfycby23aF4UE_2GGFdgFISf78RkHfZBDhV8Abpvhj_XoSHjI4QorVxPPNl0VMXKw-1S_H-/exec";
const PEGAWAI_CACHE_KEY = 'si_dakon_pegawai_cache_v1';
const SERTIFIKASI_CACHE_KEY = 'si_dakon_sertifikasi_cache_v1';

let daftarPegawai = [];
let dataSertifikasi = [];
let dtSertifikasi = null;
let isOfflineOrSandbox = false;
let parsedImportItems = [];

/**
 * Menghitung status masa berlaku sertifikat (ambang batas peringatan: 30 hari)
 */
function cekStatusMasaBerlaku(tanggalExpired) {
  if (!tanggalExpired) {
    return {
      kode: 'seumur_hidup',
      label: 'Seumur Hidup',
      pillClass: 'status-pill-lifetime',
      icon: 'fa-infinity',
      sisaHari: null
    };
  }
  const expDate = new Date(tanggalExpired + 'T23:59:59');
  if (isNaN(expDate.getTime())) {
    return {
      kode: 'seumur_hidup',
      label: 'Seumur Hidup',
      pillClass: 'status-pill-lifetime',
      icon: 'fa-infinity',
      sisaHari: null
    };
  }

  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const diffTime = expDate.getTime() - today.getTime();
  const sisaHari = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

  if (sisaHari < 0) {
    return {
      kode: 'expired',
      label: `Kedaluwarsa (${Math.abs(sisaHari)} hr lalu)`,
      pillClass: 'status-pill-expired',
      icon: 'fa-times-circle',
      sisaHari
    };
  } else if (sisaHari <= 30) {
    return {
      kode: 'segera_habis',
      label: sisaHari === 0 ? 'Habis Hari Ini!' : `Segera Habis (${sisaHari} hr lagi)`,
      pillClass: 'status-pill-warning',
      icon: 'fa-exclamation-circle',
      sisaHari
    };
  } else {
    return {
      kode: 'aktif',
      label: `Berlaku (${sisaHari} hr lagi)`,
      pillClass: 'status-pill-active',
      icon: 'fa-check-circle',
      sisaHari
    };
  }
}

/**
 * Mengecek validitas sesi login Admin di localStorage
 */
function cekStatusAdmin() {
  try {
    const session = localStorage.getItem('si_ida_session') === 'true';
    const timestamp = parseInt(localStorage.getItem('si_ida_timestamp') || '0', 10);
    const satuJam = 60 * 60 * 1000;
    if (!session) return false;
    if (timestamp && (Date.now() - timestamp > satuJam)) {
      localStorage.removeItem('si_ida_session');
      localStorage.removeItem('si_ida_timestamp');
      return false;
    }
    return true;
  } catch (e) {
    return false;
  }
}

let isAdmin = cekStatusAdmin();

function perbaruiTampilanAdmin() {
  isAdmin = cekStatusAdmin();
  if (isAdmin) {
    $('#adminBadge, #btnInputSertifikasi, #btnTemplateSertifikasi, #btnImportSertifikasi, #btnTableTemplateExcel, #btnTableImportExcel').show();
    $('#importAdminWarning').hide();
    $('#btnToggleAdmin').html('<i class="fas fa-sign-out-alt me-1"></i>Logout').removeClass('btn-outline-warning').addClass('btn-warning text-dark');
  } else {
    $('#adminBadge, #btnInputSertifikasi, #btnTemplateSertifikasi, #btnImportSertifikasi, #btnTableTemplateExcel, #btnTableImportExcel').hide();
    $('#importAdminWarning').show();
    $('#btnToggleAdmin').html('<i class="fas fa-user-lock me-1"></i>Admin Mode').removeClass('btn-warning text-dark').addClass('btn-outline-warning');
  }
  if (dtSertifikasi) {
    renderTabelSertifikasi();
  }
}

function toggleAdminSession(onSuccessCallback = null) {
  if (isAdmin && !onSuccessCallback) {
    Swal.fire({
      title: 'Logout?',
      text: 'Anda akan keluar dari Mode Admin',
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#d33',
      confirmButtonText: 'Ya, Logout',
      cancelButtonText: 'Batal'
    }).then(res => {
      if (res.isConfirmed) {
        localStorage.removeItem('si_ida_session');
        localStorage.removeItem('si_ida_timestamp');
        perbaruiTampilanAdmin();
        Swal.fire({ icon: 'success', title: 'Logout Berhasil', timer: 1200, showConfirmButton: false });
      }
    });
    return;
  }

  Swal.fire({
    title: 'Admin Login',
    html: `
      <input type="text" id="swal-username" class="swal2-input" placeholder="Username">
      <input type="password" id="swal-password" class="swal2-input" placeholder="Password">
    `,
    focusConfirm: false,
    showCancelButton: true,
    confirmButtonText: 'Sign In',
    confirmButtonColor: '#004d40',
    showLoaderOnConfirm: true,
    preConfirm: () => {
      const username = Swal.getPopup().querySelector('#swal-username').value;
      const password = Swal.getPopup().querySelector('#swal-password').value;
      if (!username || !password) {
        Swal.showValidationMessage('Harap isi username dan password');
        return false;
      }
      const finalUrl = `${SCRIPT_URL_BOS}?action=login&user=${encodeURIComponent(username)}&pass=${encodeURIComponent(password)}&t=${Date.now()}`;
      return fetch(finalUrl, { method: 'GET', mode: 'cors', redirect: 'follow' })
        .then(r => {
          if (!r.ok) throw new Error('Network error');
          return r.json();
        })
        .catch(() => {
          Swal.showValidationMessage('Koneksi gagal ke server.');
        });
    },
    allowOutsideClick: () => !Swal.isLoading()
  }).then(result => {
    if (result && result.isConfirmed && result.value) {
      if (result.value.success) {
        localStorage.setItem('si_ida_session', 'true');
        localStorage.setItem('si_ida_timestamp', String(Date.now()));
        perbaruiTampilanAdmin();
        if (typeof onSuccessCallback === 'function') {
          onSuccessCallback();
        } else {
          Swal.fire({ icon: 'success', title: 'Berhasil!', text: 'Admin Mode aktif', timer: 1300, showConfirmButton: false });
        }
      } else {
        Swal.fire('Gagal', result.value.message || 'Username / Password salah', 'error');
      }
    }
  });
}

function extractDriveFolderId(urlOrId) {
  if (!urlOrId) return '';
  const str = String(urlOrId).trim();
  if (!str || str === '-' || str.toLowerCase() === 'null' || str.toLowerCase() === 'undefined') return '';

  const folderPathMatch = str.match(/\/folders\/([a-zA-Z0-9_-]{10,})/);
  if (folderPathMatch && folderPathMatch[1]) {
    return folderPathMatch[1];
  }

  const queryIdMatch = str.match(/[?&]id=([a-zA-Z0-9_-]{10,})/);
  if (queryIdMatch && queryIdMatch[1]) {
    return queryIdMatch[1];
  }

  if (/^[a-zA-Z0-9_-]{15,60}$/.test(str) && !str.includes('http') && !str.includes(' ')) {
    return str;
  }

  return '';
}

function normalizeNip(nip) {
  return String(nip || '').replace(/^'/, '').replace(/[^a-zA-Z0-9]/g, '').toLowerCase();
}

function parseDataPegawaiSheet(resPegawai) {
  if (!resPegawai || !Array.isArray(resPegawai.headers) || !Array.isArray(resPegawai.values)) {
    return [];
  }

  const headers = resPegawai.headers.map(h => String(h || '').toUpperCase().trim());
  const idxNip = headers.findIndex(h => h.includes('NIP'));
  const idxNama = headers.findIndex(h => h.includes('NAMA'));
  let idxDokumen = headers.findIndex(h => h === 'DOKUMEN');
  if (idxDokumen === -1) {
    idxDokumen = headers.findIndex(h => h.includes('DOKUMEN') || h.includes('FOLDER'));
  }

  return resPegawai.values.map(row => {
    let rawDokumen = idxDokumen !== -1 ? String(row[idxDokumen] || '').trim() : '';
    let extractedId = extractDriveFolderId(rawDokumen);

    if (!extractedId) {
      const driveCell = row.find(cell => {
        const s = String(cell || '').trim();
        return s.includes('drive.google.com') && (s.includes('/folders/') || s.includes('id='));
      });
      if (driveCell) {
        rawDokumen = String(driveCell).trim();
        extractedId = extractDriveFolderId(rawDokumen);
      }
    }

    const normalizedUrl = rawDokumen.startsWith('http')
      ? rawDokumen
      : (extractedId ? `https://drive.google.com/drive/folders/${extractedId}` : '');

    const hasSmartChipLabel = !extractedId && rawDokumen !== '' && rawDokumen !== '-' && !rawDokumen.startsWith('http');

    return {
      nip: String(row[idxNip !== -1 ? idxNip : 1] || '').replace(/^'/, '').trim(),
      nama: String(row[idxNama !== -1 ? idxNama : 2] || '').trim(),
      dokumenRaw: rawDokumen,
      folderUrl: normalizedUrl,
      folderId: extractedId,
      hasSmartChipLabel: hasSmartChipLabel
    };
  }).filter(p => p.nama !== '');
}

function cariPegawaiDiMaster(nip, nama) {
  const cleanNip = normalizeNip(nip);
  const cleanNama = String(nama || '').trim().toLowerCase();

  let found = null;
  if (cleanNip) {
    found = daftarPegawai.find(p => normalizeNip(p.nip) === cleanNip);
  }
  if (!found && cleanNama) {
    found = daftarPegawai.find(p => p.nama.toLowerCase() === cleanNama);
  }
  return found || null;
}

