/**
 * Menghitung otomatis tanggal kedaluwarsa (Berlaku Sampai) berdasarkan Tanggal SK + Durasi Tahun
 */
function hitungTanggalExpiredDariTahun() {
  const tglSk = $('#srt_tanggal').val().trim();
  const durasi = $('#srt_masa_tahun').val();

  if (durasi === 'custom') {
    $('#srt_expired_hint').text('Silakan pilih tanggal kedaluwarsa secara manual.');
    return;
  }

  if (!durasi) {
    $('#srt_expired').val('');
    $('#srt_expired_hint').text('Sertifikat berlaku seumur hidup (tanpa batas waktu).');
    return;
  }

  const tahunTambah = parseInt(durasi, 10);
  if (!tglSk || isNaN(tahunTambah)) {
    $('#srt_expired_hint').text('Pilih Tanggal SK terlebih dahulu untuk menghitung otomatis.');
    return;
  }

  const parts = tglSk.split('-').map(Number);
  if (parts.length !== 3) return;

  const dExp = new Date(parts[0] + tahunTambah, parts[1] - 1, parts[2]);
  if (dExp.getMonth() !== parts[1] - 1) {
    dExp.setDate(0);
  }

  const expIso = `${dExp.getFullYear()}-${String(dExp.getMonth() + 1).padStart(2, '0')}-${String(dExp.getDate()).padStart(2, '0')}`;
  $('#srt_expired').val(expIso);
  $('#srt_expired_hint').html(`<span class="text-success fw-semibold">Otomatis terhitung ${tahunTambah} tahun sejak Tanggal SK (${formatTanggalIndo(expIso)}).</span>`);
}

/**
 * Menyelaraskan pilihan dropdown Masa Berlaku (Tahun) saat mode edit atau saat tanggal diubah manual
 */
function sinkronDropdownMasaBerlakuDariTanggal() {
  const tglSk = $('#srt_tanggal').val().trim();
  const tglExp = $('#srt_expired').val().trim();

  if (!tglExp) {
    $('#srt_masa_tahun').val('');
    $('#srt_expired_hint').text('Sertifikat berlaku seumur hidup (tanpa batas waktu).');
    return;
  }

  if (!tglSk) {
    $('#srt_masa_tahun').val('custom');
    $('#srt_expired_hint').text('Tanggal kedaluwarsa diatur manual.');
    return;
  }

  const pSk = tglSk.split('-').map(Number);
  let matchedTahun = '';
  for (let yr = 1; yr <= 5; yr++) {
    const dTest = new Date(pSk[0] + yr, pSk[1] - 1, pSk[2]);
    if (dTest.getMonth() !== pSk[1] - 1) dTest.setDate(0);
    const isoTest = `${dTest.getFullYear()}-${String(dTest.getMonth() + 1).padStart(2, '0')}-${String(dTest.getDate()).padStart(2, '0')}`;
    if (isoTest === tglExp) {
      matchedTahun = String(yr);
      break;
    }
  }

  if (matchedTahun) {
    $('#srt_masa_tahun').val(matchedTahun);
    $('#srt_expired_hint').html(`<span class="text-success fw-semibold">Masa berlaku ${matchedTahun} tahun sejak Tanggal SK.</span>`);
  } else {
    $('#srt_masa_tahun').val('custom');
    $('#srt_expired_hint').text('Tanggal kedaluwarsa diatur manual.');
  }
}

function fileToBase64Clean(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => {
      const result = String(reader.result || '');
      const base64Only = result.includes(',') ? result.split(',')[1] : result;
      resolve(base64Only);
    };
    reader.onerror = err => reject(err);
    reader.readAsDataURL(file);
  });
}

function safeJenisName(jenis) {
  return String(jenis || 'Diklat').replace(/[^a-zA-Z0-9]+/g, '_');
}

$('#formSertifikat').on('submit', async function(e) {
  e.preventDefault();
  if (!isAdmin) return;

  const id = $('#srt_id').val().trim();
  const nip = $('#srt_nip').val().trim();
  const nama = $('#srt_nama').val().trim();
  const jenis = $('#srt_jenis').val().trim();
  const nomor = $('#srt_nomor').val().trim();
  const judul = $('#srt_judul').val().trim();
  const penyelenggara = $('#srt_penyelenggara').val().trim();
  const tanggal = $('#srt_tanggal').val().trim();
  const tanggalExpired = $('#srt_expired').val().trim();
  const jp = parseFloat($('#srt_jp').val()) || 0;
  const existingLink = $('#srt_existing_link').val().trim();

  if (!nama) {
    Swal.fire('Pegawai Belum Dipilih', 'Silakan ketik dan pilih nama pegawai dari daftar yang tersedia.', 'warning');
    return;
  }

  let folderUrl = $('#srt_folder_url').val().trim();
  let folderId = $('#srt_folder_id').val().trim() || extractDriveFolderId(folderUrl);

  if (!folderId) {
    const matchedPegawai = cariPegawaiDiMaster(nip, nama);
    if (matchedPegawai && matchedPegawai.folderId) {
      folderUrl = matchedPegawai.folderUrl;
      folderId = matchedPegawai.folderId;
    }
  }

  const fileInput = document.getElementById('srt_file');
  const file = fileInput && fileInput.files ? fileInput.files[0] : null;

  if (file) {
    const maxBytes = 5 * 1024 * 1024;
    if (file.size > maxBytes) {
      Swal.fire('Ukuran File Terlalu Besar', 'Maksimal ukuran file sertifikat adalah 5 MB.', 'warning');
      return;
    }
  }

  Swal.fire({
    title: 'Menyimpan Riwayat...',
    html: file
      ? `Mengunggah berkas dan menyimpannya ke direktori arsip pegawai (<code>${nama}</code>)...`
      : 'Menyimpan data sertifikasi ke sistem...',
    allowOutsideClick: false,
    didOpen: () => Swal.showLoading()
  });

  try {
    let base64Data = '';
    let fileName = '';
    let mimeType = '';

    if (file) {
      base64Data = await fileToBase64Clean(file);
      const ext = file.name.includes('.') ? file.name.substring(file.name.lastIndexOf('.')) : '';
      const safeJudul = judul.replace(/[^a-zA-Z0-9_-]+/g, '_').substring(0, 40);
      const safeNama = nama.replace(/[^a-zA-Z0-9_-]+/g, '_').substring(0, 30);
      fileName = `Sertifikat_${safeJenisName(jenis)}_${safeNama}_${safeJudul}${ext}`;
      mimeType = file.type || 'application/pdf';
    }

    const payload = {
      action: 'saveSertifikasi',
      id: id,
      nip: nip,
      nama: nama,
      jenis: jenis,
      nomor: nomor,
      judul: judul,
      penyelenggara: penyelenggara,
      tanggal: tanggal,
      tanggalExpired: tanggalExpired,
      jp: jp,
      existingLink: existingLink,
      folderUrl: folderUrl,
      folderId: folderId,
      targetFolderId: folderId,
      parentFolderId: folderId,
      dokumenFolderUrl: folderUrl,
      base64Data: base64Data,
      fileName: fileName,
      mimeType: mimeType
    };

    const response = await fetch(SCRIPT_URL_BOS, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(payload)
    });

    let resJson = null;
    try {
      resJson = await response.json();
    } catch (parseErr) {}

    if (resJson && (resJson.success === false || resJson.status === 'error')) {
      throw new Error(resJson.message || 'Gagal menyimpan data di server GAS.');
    }

    $('#modalSertifikat').modal('hide');
    Swal.fire({
      icon: 'success',
      title: 'Berhasil Disimpan!',
      text: file
        ? 'Sertifikat berhasil diunggah ke arsip digital pegawai.'
        : 'Data riwayat sertifikasi berhasil diperbarui.',
      timer: 2000,
      showConfirmButton: false
    });

