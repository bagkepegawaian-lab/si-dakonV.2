function getDirectDownloadUrl(url) {
  if (!url) return '';
  const fileMatch = url.match(/\/file\/d\/([-\w]{20,})/) || url.match(/[?&]id=([-\w]{20,})/);
  if (fileMatch && fileMatch[1] && !url.includes('/folders/')) {
    return `https://drive.google.com/uc?export=download&id=${fileMatch[1]}`;
  }
  return url;
}

function getDrivePreviewUrl(url) {
  if (!url) return '';
  const fileMatch = url.match(/\/file\/d\/([-\w]{20,})/) || url.match(/[?&]id=([-\w]{20,})/);
  if (fileMatch && fileMatch[1] && !url.includes('/folders/')) {
    return `https://drive.google.com/file/d/${fileMatch[1]}/preview`;
  }
  return url;
}

function previewBerkasSertifikat(link, judul) {
  const previewUrl = getDrivePreviewUrl(link);
  const dlUrl = getDirectDownloadUrl(link);
  Swal.fire({
    title: `<span style="color:#004d40; font-weight:800; font-size:16px;"><i class="fas fa-file-alt me-2"></i>Preview: ${judul || 'Sertifikat'}</span>`,
    width: '860px',
    html: `
      <div style="border:1px solid #e2e8f0; border-radius:12px; overflow:hidden; height:490px; background:#f8fafc;">
        <iframe src="${previewUrl}" width="100%" height="100%" style="border:none;" allow="autoplay"></iframe>
      </div>
    `,
    showCancelButton: true,
    confirmButtonText: '<i class="fas fa-download me-1"></i> Unduh Berkas',
    cancelButtonText: 'Tutup',
    confirmButtonColor: '#059669'
  }).then(res => {
    if (res.isConfirmed) {
      window.open(dlUrl, '_blank');
    }
  });
}

