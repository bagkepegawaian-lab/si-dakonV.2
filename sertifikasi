  });

  doc.autoTable({
    head: [['No', 'Nama & NIP Pegawai', 'Jenis', 'Judul & Nomor Sertifikat', 'Penyelenggara', 'Tgl Terbit', 'Masa Berlaku', 'JP']],
    body: body,
    startY: 25,
    theme: 'grid',
    styles: { fontSize: 7.5, cellPadding: 2.2, valign: 'middle' },
    headStyles: { fillColor: [0, 77, 64], textColor: [255, 255, 255], halign: 'center' },
    columnStyles: {
      0: { halign: 'center', cellWidth: 9 },
      5: { halign: 'center', cellWidth: 22 },
      6: { halign: 'center', cellWidth: 28 },
      7: { halign: 'center', cellWidth: 15 }
    },
    didDrawPage: function() {
      doc.setFontSize(8);
      doc.setTextColor(100);
      doc.text(`Dicetak: ${tglCetak}`, pageWidth - 14, pageHeight - 8, { align: "right" });
    }
  });

  const pdfUrl = doc.output('bloburl');
  Swal.fire({
    title: '<span style="color:#004d40; font-weight:800; font-size:16px;"><i class="fas fa-file-pdf text-danger me-2"></i>Preview Laporan Sertifikasi</span>',
    width: '920px',
    html: `<div style="border:1px solid #e2e8f0; border-radius:12px; overflow:hidden; height:480px;"><iframe src="${pdfUrl}" width="100%" height="100%" style="border:none;"></iframe></div>`,
    showCancelButton: true,
    confirmButtonText: '<i class="fas fa-download me-1"></i> Unduh PDF',
    cancelButtonText: 'Tutup',
    confirmButtonColor: '#004d40'
  }).then(res => {
    if (res.isConfirmed) {
      doc.save(`Laporan_Sertifikasi_Pegawai_${Date.now()}.pdf`);
    }
  });
}

$(document).ready(function() {
  perbaruiTampilanAdmin();
  muatSemuaData(false);

  // Event pencarian & filter real-time
  $('#filterSearch').on('input', function() {
    perbaruiStatistik();
    renderTabelSertifikasi();
  });
  $('#filterJenis, #filterStatus, #filterTahun').on('change', function() {
    perbaruiStatistik();
    renderTabelSertifikasi();
  });

  // Perhitungan otomatis masa berlaku dari Tanggal SK + Masa Berlaku (Tahun)
  $('#srt_tanggal, #srt_masa_tahun').on('change', function() {
    hitungTanggalExpiredDariTahun();
  });
  $('#srt_expired').on('change', function() {
    sinkronDropdownMasaBerlakuDariTanggal();
  });

  // Drag & Drop serta Klik pada area Import Excel
  const dropzone = document.getElementById('importDropzone');
  const fileInputImport = document.getElementById('importSertifikasiFile');
  const btnPilihFile = document.getElementById('btnPilihFileExcel');

  if (btnPilihFile && fileInputImport) {
    btnPilihFile.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      fileInputImport.value = '';
      fileInputImport.click();
    });
  }

  if (dropzone && fileInputImport) {
    dropzone.addEventListener('click', function(e) {
      if (e.target.closest('#btnPilihFileExcel')) return;
      fileInputImport.value = '';
      fileInputImport.click();
    });
    dropzone.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInputImport.value = '';
        fileInputImport.click();
      }
    });
    dropzone.addEventListener('dragover', function(e) {
      e.preventDefault();
      dropzone.classList.add('dragover');
    });
    dropzone.addEventListener('dragleave', function() {
      dropzone.classList.remove('dragover');
    });
    dropzone.addEventListener('drop', function(e) {
      e.preventDefault();
      dropzone.classList.remove('dragover');
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
        prosesBacaFileExcelImport(e.dataTransfer.files[0]);
      }
    });
  }

  $('#srt_pegawai_search').on('input change', function() {
    const val = $(this).val().trim();
    if (!val) {
      resetPilihanPegawai(false);
      return;
    }

    const qLower = val.toLowerCase();
    let p = daftarPegawai.find(item => `${item.nama} (${item.nip || 'Tanpa NIP'})`.toLowerCase() === qLower) ||
            daftarPegawai.find(item => item.nama.toLowerCase() === qLower || (item.nip && item.nip.toLowerCase() === qLower));

    if (!p && val.length >= 3) {
      const matches = daftarPegawai.filter(item =>
        item.nama.toLowerCase().includes(qLower) || (item.nip && item.nip.toLowerCase().includes(qLower))
      );
      if (matches.length === 1) {
        p = matches[0];
      }
    }

    if (p) {
      $('#srt_nip').val(p.nip);
      $('#srt_nama').val(p.nama);
      $('#srt_folder_url').val(p.folderUrl || '');
      $('#srt_folder_id').val(p.folderId || '');
      $('#srt_dokumen_raw').val(p.dokumenRaw || '');
      perbaruiInfoFolderPegawai(p.folderUrl || '', p.folderId || '', p.dokumenRaw || '');
    } else {
      $('#srt_nip').val('');
      $('#srt_nama').val('');
      $('#srt_folder_url').val('');
      $('#srt_folder_id').val('');
      $('#srt_dokumen_raw').val('');
      perbaruiInfoFolderPegawai('', '', '');
    }
  });
});
</script>
