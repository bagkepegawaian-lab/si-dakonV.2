function formatTanggalIndo(val) {
  if (!val) return '-';
  const d = new Date(val);
  if (isNaN(d.getTime())) return String(val);
  const day = String(d.getDate()).padStart(2, '0');
  const month = String(d.getMonth() + 1).padStart(2, '0');
  const year = d.getFullYear();
  return `${day}-${month}-${year}`;
}

/**
 * Mengonversi berbagai format tanggal (Date object, serial number Excel, YYYY-MM-DD, DD/MM/YYYY, DD-MM-YYYY) ke YYYY-MM-DD
 */
function formatTanggalInput(val) {
  if (val === null || val === undefined || val === '') return '';

  // Tangani serial number tanggal dari Excel (misal: 46157)
  if (typeof val === 'number' && val > 20000 && val < 90000) {
    const utcDays = Math.floor(val - 25569);
    const utcValue = utcDays * 86400;
    const dateInfo = new Date(utcValue * 1000);
    if (!isNaN(dateInfo.getTime())) {
      const y = dateInfo.getUTCFullYear();
      const m = String(dateInfo.getUTCMonth() + 1).padStart(2, '0');
      const d = String(dateInfo.getUTCDate()).padStart(2, '0');
      return `${y}-${m}-${d}`;
    }
  }

  const str = String(val).trim();
  if (!str || str === '-') return '';

  if (/^\d{4}-\d{2}-\d{2}/.test(str)) return str.substring(0, 10);

  // Format DD/MM/YYYY atau DD-MM-YYYY
  const dmyMatch = str.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})$/);
  if (dmyMatch) {
    const day = dmyMatch[1].padStart(2, '0');
    const month = dmyMatch[2].padStart(2, '0');
    const year = dmyMatch[3];
    return `${year}-${month}-${day}`;
  }

  const d = new Date(str);
  if (isNaN(d.getTime())) return '';
  const year = d.getFullYear();
  const month = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
}

function isiFilterTahun() {
  const tahunSet = new Set();
  dataSertifikasi.forEach(item => {
    if (item.tanggal && item.tanggal.length >= 4) {
      tahunSet.add(item.tanggal.substring(0, 4));
    }
  });
  const sortedYears = Array.from(tahunSet).sort((a, b) => b.localeCompare(a));
  const currentVal = $('#filterTahun').val();
  let html = '<option value="">Semua</option>';
  sortedYears.forEach(yr => {
    html += `<option value="${yr}">${yr}</option>`;
  });
  $('#filterTahun').html(html);
  if (currentVal) $('#filterTahun').val(currentVal);
}

function getFilteredSertifikasi() {
  const q = ($('#filterSearch').val() || '').trim().toLowerCase();
  const fJenis = ($('#filterJenis').val() || '').trim();
  const fStatus = ($('#filterStatus').val() || '').trim();
  const fTahun = ($('#filterTahun').val() || '').trim();

  return dataSertifikasi.filter(item => {
    if (fJenis && item.jenis !== fJenis) return false;
    if (fTahun && (!item.tanggal || !item.tanggal.startsWith(fTahun))) return false;

    if (fStatus) {
      const st = cekStatusMasaBerlaku(item.tanggalExpired).kode;
      if (fStatus === 'perlu_perhatian') {
        if (st !== 'expired' && st !== 'segera_habis') return false;
      } else if (st !== fStatus) {
        return false;
      }
    }

    if (q) {
      const gabung = `${item.nama} ${item.nip} ${item.judul} ${item.nomor} ${item.penyelenggara} ${item.jenis}`.toLowerCase();
      if (!gabung.includes(q)) return false;
    }
    return true;
  });
}

function perbaruiStatistik() {
  const filtered = getFilteredSertifikasi();

  const totalSertifikat = filtered.length;
  const pegawaiUnik = new Set(filtered.map(i => normalizeNip(i.nip) || i.nama.toLowerCase()).filter(Boolean)).size;
  const totalJP = filtered.reduce((acc, cur) => acc + (Number(cur.jp) || 0), 0);

  const jmlExpired = dataSertifikasi.filter(i => cekStatusMasaBerlaku(i.tanggalExpired).kode === 'expired').length;
  const jmlSegeraHabis = dataSertifikasi.filter(i => cekStatusMasaBerlaku(i.tanggalExpired).kode === 'segera_habis').length;
  const totalPerluPerhatian = jmlExpired + jmlSegeraHabis;

  $('#stat-total-sertifikat').text(totalSertifikat);
  $('#stat-total-pegawai').text(pegawaiUnik);
  $('#stat-total-jp').text(`${totalJP} JP`);
  $('#stat-perlu-perhatian').text(totalPerluPerhatian);
  $('#stat-perlu-perhatian-sub').text(`${jmlExpired} kedaluwarsa • ${jmlSegeraHabis} segera habis`);

  if (totalPerluPerhatian > 0) {
    $('#alert-expired-text').html(
      `Terdapat <b>${jmlSegeraHabis} sertifikat akan habis (&le;30 hari)</b> dan <b>${jmlExpired} sertifikat sudah kedaluwarsa</b>.`
    );
    $('#alert-expired-banner').attr('style', 'display: flex !important;');
  } else {
    $('#alert-expired-banner').attr('style', 'display: none !important;');
  }

  renderPieChartJenisDiklat(filtered);
}

let pieChartJenisInstance = null;

/**
 * Merender Diagram Pie perbandingan berdasarkan jenis diklat & sertifikasi
 */
function renderPieChartJenisDiklat(items) {
  const canvas = document.getElementById('pieChartJenisDiklat');
  if (!canvas) return;

  const total = items.length;
  $('#badge-chart-jenis-total').text(`Total: ${total} Sertifikat`);

  if (total === 0) {
    if (pieChartJenisInstance) {
      pieChartJenisInstance.destroy();
      pieChartJenisInstance = null;
    }
    $('#legendJenisDiklatContainer').html(
      '<div class="col-12 text-center text-muted py-4 small">Belum ada data sertifikasi pada filter ini.</div>'
    );
    return;
  }

  const jenisMap = {};
  items.forEach(it => {
    const j = it.jenis || 'Lainnya';
    if (!jenisMap[j]) jenisMap[j] = { count: 0, jp: 0 };
    jenisMap[j].count += 1;
    jenisMap[j].jp += (Number(it.jp) || 0);
  });

  const sorted = Object.entries(jenisMap).sort((a, b) => b[1].count - a[1].count);
  const labels = sorted.map(e => e[0]);
  const counts = sorted.map(e => e[1].count);
  const palette = ['#004d40', '#ffb74d', '#0288d1', '#10b981', '#8b5cf6', '#f43f5e', '#14b8a6', '#f97316'];
  const colors = labels.map((_, idx) => palette[idx % palette.length]);

  const legendHtml = sorted.map(([jenisLabel, info], idx) => {
    const color = colors[idx];
    const pct = ((info.count / total) * 100).toFixed(1);
    const safeJenis = jenisLabel.replace(/'/g, "\\'").replace(/"/g, '&quot;');
    return `
      <div class="col-sm-6">
        <div onclick="bukaDetailJenisDiklat('${safeJenis}')" class="px-3 py-2 rounded-3 border bg-white h-100 d-flex flex-column justify-content-center" style="cursor:pointer; transition:all 0.2s ease; border-color:#e2e8f0 !important;" onmouseover="this.style.borderColor='${color}'; this.style.backgroundColor='#f8fafc'" onmouseout="this.style.borderColor='#e2e8f0'; this.style.backgroundColor='#ffffff'">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <div class="d-flex align-items-center gap-2 text-truncate pe-2">
              <span style="width:9px; height:9px; border-radius:50%; background:${color}; flex-shrink:0;"></span>
              <span class="fw-semibold text-dark text-truncate" style="font-size:0.78rem;" title="${safeJenis}">${jenisLabel}</span>
            </div>
            <div class="text-nowrap">
              <span class="fw-bold" style="color:${color}; font-size:0.85rem;">${info.count}</span>
              <span class="text-muted ms-1" style="font-size:0.7rem;">(${pct}%)</span>
            </div>
          </div>
          <div class="progress" style="height:4px; border-radius:10px; background-color:#f1f5f9;">
            <div class="progress-bar" style="width:${pct}%; background-color:${color}; border-radius:10px;"></div>
          </div>
        </div>
      </div>
    `;
  }).join('');
  $('#legendJenisDiklatContainer').html(legendHtml);

  const ctx = canvas.getContext('2d');
  if (pieChartJenisInstance) pieChartJenisInstance.destroy();
  pieChartJenisInstance = new Chart(ctx, {
    type: 'doughnut',
    data: {
      labels: labels,
      datasets: [{
        data: counts,
        backgroundColor: colors,
        borderColor: '#ffffff',
        borderWidth: 2,
        hoverOffset: 6
      }]
    },
    options: {
      maintainAspectRatio: false,
      cutout: '68%',
      onHover: (evt, elements) => {
        evt.native.target.style.cursor = elements.length ? 'pointer' : 'default';
      },
      onClick: (evt, elements) => {
        if (elements.length > 0) {
          const jenisDipilih = labels[elements[0].index];
          bukaDetailJenisDiklat(jenisDipilih);
        }
      },
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: (context) => {
              const val = context.parsed || 0;
              const pct = ((val / total) * 100).toFixed(1);
              return ` ${context.label}: ${val} sertifikat (${pct}%)`;
            }
          }
        }
      }
    }
  });
}

